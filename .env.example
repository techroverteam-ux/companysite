# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.
# Wrap values in double quotes if they contain # or spaces.

# ---- Required -------------------------------------------------------
# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="techrover"

# Random secret that signs staff login sessions (at least 32 characters).
# Generate one with:  openssl rand -base64 48
AUTH_SECRET=""

# First owner account. Used ONLY while there are no staff accounts in the database:
# log in at /admin/login with these to create the owner, then add your team in Staff & Roles.
ADMIN_NAME="Ashok Verma"
ADMIN_EMAIL="you@techrover.co.in"
ADMIN_PASSWORD=""

# Public address of the site, used in client links and emails.
SITE_URL="https://techrover.co.in"

# ---- Vercel Blob (file uploads) -------------------------------------
# Added automatically when a Blob store is connected to the Vercel project.
# For local development run `vercel env pull .env.local`.
BLOB_READ_WRITE_TOKEN=""
BLOB_MAX_MB=50

# ---- Optional: email (Resend) ---------------------------------------
# Without these, everything still works; notifications stay in-app only.
RESEND_API_KEY=""
EMAIL_FROM="TechRover <hello@techrover.co.in>"
# Extra inboxes that get every new website lead
NOTIFY_EMAIL="sales@techrover.co.in"

# ---- Optional: Razorpay payment links -------------------------------
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Webhook URL: https://<site>/api/webhooks/razorpay  (event: payment_link.paid)
RAZORPAY_WEBHOOK_SECRET=""

# ---- Optional: GitHub (commits/PRs mentioning TR-<number> show on tasks)
# Repo → Settings → Webhooks → https://<site>/api/webhooks/github, JSON, push + pull_request
GITHUB_WEBHOOK_SECRET=""

# ---- Invoice details ------------------------------------------------
COMPANY_NAME="TechRover"
COMPANY_ADDRESS="Registered office address, City, State PIN"
COMPANY_GSTIN=""
COMPANY_EMAIL="accounts@techrover.co.in"
COMPANY_BANK_DETAILS="Bank: …  A/c: …  IFSC: …  UPI: …"

# Days of free support after delivery sign-off
WARRANTY_DAYS=90
# Link shown to happy clients after they leave a review
GOOGLE_REVIEW_URL=""
